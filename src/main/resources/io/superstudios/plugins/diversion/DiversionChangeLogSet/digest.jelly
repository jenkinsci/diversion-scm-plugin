<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
  <!--
    Required by jenkins.scm.RunWithSCM/changesets.jelly on the build/job page.
    Missing this view 500s the whole page:
    No page found 'digest.jelly' for class DiversionChangeLogSet
  -->
  <j:choose>
    <j:when test="${it.emptySet}">
      ${%No changes.}
    </j:when>
    <j:otherwise>
      ${%Summary}
      <ol>
        <j:forEach var="cs" items="${it.items}" varStatus="loop">
          <li>
            <st:include it="${cs}" page="digest.jelly"/>
            <j:if test="${it.run != null}">
              <st:nbsp/>
              <a href="${rootURL}/${it.run.url}changes#detail${loop.index}">${%detail}</a>
            </j:if>
          </li>
        </j:forEach>
      </ol>
    </j:otherwise>
  </j:choose>
</j:jelly>
